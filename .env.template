# postgresql://gawain:<PASSWORD>@<cluster-host>.cockroachlabs.cloud:26257/creative-finance?sslmode=verify-full
COCKROACHDB_URL=

# Webhooks
CROSSMINT_WEBHOOK_SECRET=
GOLDSKY_WEBHOOK_SECRET=

# Vercel Cron authentication
CRON_SECRET=

# Wert (alternative onramp)
