  vaultWithdrawFees(
    request: {
      chainId: 1
      vault: "0x1234567890abcdef1234567890abcdef12345678"
      amount: {
        exact: "1000"
        # OR
        # max: true
      }
      # sendTo: "0x1234…", if different from vault owner
    }
  ) {
    to
    from
    data
    value
    chainId
  }
}
